+/-- LEMMA patch 0001: `Nat.add`, exact or abort. Overflow of `a + b` (mod 2^64) ⇔ `r < a`. -/
+private def lowerNatAdd (a b : Val) : LowerM Val := do
+  let ra ← valToReg a
+  let rb ← valToReg b
+  let r ← freshVReg
+  emit (.binOp .add64 r ra rb)
+  let abortB ← newAbortBlock
+  let cont ← newBlock
+  setTerm (.brCmp .ult r ra abortB #[] cont #[])
+  switchBlock cont
+  return .reg r
+
+/-- LEMMA patch 0001: `Nat.mul`, exact or abort.
+    Overflow ⇔ `a ≠ 0 ∧ (a * b mod 2^64) / a ≠ b`. -/
+private def lowerNatMul (a b : Val) : LowerM Val := do
+  let ra ← valToReg a
+  let rb ← valToReg b
+  let r ← freshVReg
+  emit (.binOp .mul64 r ra rb)
+  let abortB ← newAbortBlock
+  let chk ← newBlock
+  let cont ← newBlock
+  setTerm (.brCmpImm .eq ra 0 cont #[] chk #[])
+  switchBlock chk
+  let q ← freshVReg
+  emit (.binOp .div64 q r ra)
+  setTerm (.brCmp .ne q rb abortB #[] cont #[])
+  switchBlock cont
+  return .reg r
+
+/-- Two-way select joined through a block parameter: `if lhs op rhs then thenV else elseV`,
+    where the two arms are emitted by `mkThen` / `mkElse` in fresh blocks. -/
+private def lowerSelect (op : CmpOp) (lhs rhs : VReg)
+    (mkThen mkElse : LowerM VReg) : LowerM Val := do
+  let p ← freshVReg
+  let tB ← newBlock
+  let eB ← newBlock
+  let join ← newBlock #[p]
+  setTerm (.brCmp op lhs rhs tB #[] eB #[])
+  switchBlock tB
+  let tv ← mkThen
+  setTerm (.jmp join #[tv])
+  switchBlock eB
+  let ev ← mkElse
+  setTerm (.jmp join #[ev])
+  switchBlock join
+  return .reg p
+
+/-- LEMMA patch 0001: `Nat.sub` truncates at zero (exact Lean semantics). -/
+private def lowerNatSub (a b : Val) : LowerM Val := do
+  let ra ← valToReg a
+  let rb ← valToReg b
+  lowerSelect .ult ra rb (emitConst 0) (do
+    let d ← freshVReg; emit (.binOp .sub64 d ra rb); return d)
+
+/-- LEMMA patch 0001: `Nat.div x 0 = 0` (exact Lean semantics; no sBPF divide-by-zero trap). -/
+private def lowerNatDiv (a b : Val) : LowerM Val := do
+  let ra ← valToReg a
+  let rb ← valToReg b
+  let z ← emitConst 0
+  lowerSelect .eq rb z (emitConst 0) (do
+    let d ← freshVReg; emit (.binOp .div64 d ra rb); return d)
+
+/-- LEMMA patch 0001: `Nat.mod x 0 = x` (exact Lean semantics; no sBPF divide-by-zero trap). -/
+private def lowerNatMod (a b : Val) : LowerM Val := do
+  let ra ← valToReg a
+  let rb ← valToReg b
+  let z ← emitConst 0
+  lowerSelect .eq rb z (pure ra) (do
+    let d ← freshVReg; emit (.binOp .mod64 d ra rb); return d)
+
+/-- LEMMA patch 0001: `UIntN.ofNatTruncate n = min n (2^N - 1)` (clamp, not mask). -/
+private def lowerOfNatTruncate (v : Val) (maxV : UInt64) : LowerM Val := do
+  match v with
+  | .natLit n => return .reg (← emitConst (if n > maxV.toNat then maxV else n.toUInt64))
+  | _ =>
+    let r ← valToReg v
+    let m ← emitConst maxV
+    lowerSelect .ugt r m (pure m) (pure r)
+
