-  | .natLit n => emitConst n.toUInt64
+  | .natLit n => natLitToReg n
   | .erased => emitConst 0
   | .ctorVal tag #[] => emitConst tag.toUInt64
   | .ctorVal tag #[.erased] => emitConst tag.toUInt64
