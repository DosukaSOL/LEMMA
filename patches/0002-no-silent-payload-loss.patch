diff --git a/LeanSVM/Compiler/Lower.lean b/LeanSVM/Compiler/Lower.lean
index 0ea5365..36fff7e 100644
--- a/LeanSVM/Compiler/Lower.lean
+++ b/LeanSVM/Compiler/Lower.lean
@@ -219,9 +219,18 @@ private def valToReg (v : Val) : LowerM VReg := do
   | .ctorVal 0 #[a, .erased] => valToReg a
   | .ctorVal tag #[a] =>
     -- Single-field wrapper (e.g. `UInt64.mk`, `BitVec.ofFin`, `Fin.mk`)
-    if tag == 0 then valToReg a else emitConst tag.toUInt64
+    if tag == 0 then valToReg a
+    else
+      -- LEMMA patch 0002: upstream returned only the tag here, silently discarding the
