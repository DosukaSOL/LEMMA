+      match a with
+      | .erased => emitConst tag.toUInt64
+      | _ => throw s!"constructor (tag {tag}) with a runtime payload cannot be passed through a single-register slot (e.g. an `Option`/sum value flowing through an `if` join point or a multi-branch return); restructure the code (LEMMA patch 0002)"
   | .structVal #[a] => valToReg a
-  | .dynCtor tag _ => return tag
+  | .dynCtor tag payloads =>
+    -- LEMMA patch 0002: same silent payload loss for dynamically-tagged constructors.
+    if payloads.isEmpty then return tag
+    else throw s!"dynamically-tagged constructor with {payloads.size} runtime payload(s) cannot be passed through a single-register slot (LEMMA patch 0002)"
   | other => throw s!"expected scalar value for register, got: {repr other}"
 
